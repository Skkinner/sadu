# Copy to .env.local and fill in. Everything is server-side; nothing here reaches the browser.

# Layer 1 · LLM (station stories, quizzes, narrative bridges, summaries) — Anthropic Claude
ANTHROPIC_API_KEY=
# SADU_LLM_MODEL=claude-opus-5-5
# SADU_LLM_TIMEOUT_MS=90000

# Layer 1 · Neural text-to-speech — Azure AI Speech (Speech resource key + region, e.g. uaenorth, westeurope)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=   # optional: custom endpoint, e.g. a self-hosted Speech container
# SADU_TTS_VOICE_AR_CALM=ar-SA-HamedNeural
# SADU_TTS_VOICE_AR_LIVELY=ar-SA-ZariyahNeural
# SADU_TTS_VOICE_EN_CALM=en-US-GuyNeural
# SADU_TTS_VOICE_EN_LIVELY=en-US-JennyNeural

# Database: Netlify Database (Postgres). Nothing to set on Netlify or under `netlify dev`: the connection is
# provided automatically. Locally, run `netlify database migrations apply` once to create the tables.
# Optional: point at any other Postgres instead (then plain `npm run dev` works too).
# SADU_DATABASE_URL=postgres://user:password@localhost:5432/sadu
